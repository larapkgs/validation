{
  "name": "larapkgs/validation",
  "description": "An immutability-first, strongly typed validation package for Laravel.",
  "keywords": [
    "laravel",
    "validation",
    "validator",
    "octane",
    "strongly-typed",
    "immutable",
    "domain-driven"
  ],
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "LaraPkgs",
      "email": "mail@larapkgs.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/console": "^12.0 || ^13.0",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0",
    "illuminate/validation": "^12.0 || ^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.29",
    "orchestra/testbench": "^10.0 || ^11.0",
    "pestphp/pest": "^3.0 || ^4.0"
  },
  "autoload": {
    "psr-4": {
      "LaraPkgs\\Validation\\": "src/"
    },
    "files": [
      "src/Support/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "LaraPkgs\\Validation\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "LaraPkgs\\Validation\\ValidationServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest",
    "analyse": "phpstan analyse --memory-limit=1G",
    "format": "pint"
  }
}
